#!/bin/sh /etc/rc.common
USE_PROCD=1
START=18
STOP=9

start_service() {
    . /usr/libexec/heizungpanel/access_config.sh
    access_load || return 2
    /usr/libexec/heizungpanel/access_firewall.sh check || return 2
    if [ "$ACCESS_ENABLED" = 1 ]; then
        /usr/libexec/heizungpanel/access_firewall.sh setup || return 1
    fi
    procd_open_instance
    procd_set_param command /usr/libexec/heizungpanel/access.sh daemon
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger heizungpanel
}
